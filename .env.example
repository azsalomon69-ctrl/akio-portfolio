# Never commit real API keys. Add them in the Render dashboard.
FRONTEND_URL=https://your-vercel-project.vercel.app
# Optional comma-separated additional origins (for example, preview or custom domains).
ALLOWED_ORIGINS=

# Free Audius API key used only by the Render backend. Never add the bearer token.
AUDIUS_API_KEY=

NVIDIA_API_KEY_1=
NVIDIA_MODEL_1=openai/gpt-oss-120b

NVIDIA_API_KEY_2=
NVIDIA_MODEL_2=nvidia/nemotron-3-ultra-550b-a55b

NVIDIA_API_KEY_3=
NVIDIA_MODEL_3=openai/gpt-oss-20b

NVIDIA_API_KEY_4=
NVIDIA_MODEL_4=meta/llama-3.1-8b-instruct

NVIDIA_API_KEY_5=
NVIDIA_MODEL_5=nvidia/nemotron-3-super-120b-a12b

# Loopline social project. The matching email receives the admin role at registration.
SOCIAL_ADMIN_EMAIL=you@example.com
# Optional persistent database directory on the backend host.
SOCIAL_DATA_DIR=./data
# Seed the 15 disclosed AI community accounts and allow dynamic interactions.
SOCIAL_AI_ENABLED=true
# Set false to keep direct replies enabled while disabling proactive comments.
SOCIAL_AI_PROACTIVE=true
# Shared ceiling across all AI accounts. Allowed range: 1-60 actions per hour.
SOCIAL_AI_MAX_ACTIONS_PER_HOUR=12
